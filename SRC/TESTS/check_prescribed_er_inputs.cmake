foreach(mode mapping_empty mapping_one mapping_two mapping_three er_empty er_one
             mapping_repeat_radius mapping_repeat_psi mapping_unsorted_psi
             er_repeat mapping_nonfinite er_nonfinite)
  if(mode MATCHES "^(mapping_(empty|one|two|three)|er_(empty|one))$")
    set(expected "too few data rows")
  elseif(mode MATCHES "nonfinite$")
    set(expected "contains nonfinite values")
  elseif(mode MATCHES "mapping_(repeat_psi|unsorted_psi)")
    set(expected "poloidal flux must be strictly monotonic")
  elseif(mode STREQUAL "mapping_repeat_radius")
    set(expected "Er mapping radii must be strictly increasing")
  else()
    set(expected "Er profile radii must be strictly increasing")
  endif()
  execute_process(COMMAND "${TEST_EXE}" "${mode}" WORKING_DIRECTORY "${WORK_DIR}"
                  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if("${result}" STREQUAL "0")
    message(FATAL_ERROR "${mode}: invalid input was accepted")
  endif()
  string(FIND "${output}\n${error}" "${expected}" diagnostic)
  if(diagnostic EQUAL -1)
    message(FATAL_ERROR "${mode}: expected '${expected}', got:\n${error}")
  endif()
endforeach()
